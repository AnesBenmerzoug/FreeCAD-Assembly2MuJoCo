  <url branch="main" type="repository">https://github.com/AnesBenmerzoug/FreeCAD-Assembly2MuJoCo</url>
  <url type="bugtracker">https://github.com/AnesBenmerzoug/FreeCAD-Assembly2MuJoCo/issues</url>
  <url type="readme">https://github.com/AnesBenmerzoug/FreeCAD-Assembly2MuJoCo/blob/main/README.md</url>

  <icon>resources/icons/assembly2mujoco-icon.svg</icon>

  <content>
