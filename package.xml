  <author email="anes.benmerzoug@gmail.com">Anes Benmerzoug</author>
  <maintainer email="anes.benmerzoug@gmail.com">Anes Benmerzoug</maintainer>
  <license file="LICENSE">LGPL-2.1-or-later</license>
